NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/desarrollo.db
UI_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
# Solo local. Configurar un secreto seguro y persistente en cada entorno real.
JWT_SECRET=desarrollo-local-cambiar-este-secreto-antes-de-publicar
ALLOW_DEMO=false
NOTIFICATION_MODE=capture
BUSINESS_DAYS=0,1,2,3,4,5,6
BUSINESS_HOLIDAYS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Solo entorno académico controlado; en producción registrar clientes por flujo aprobado.
ALLOW_CLIENT_REGISTRATION=true
# Ruta local persistente, se crea automáticamente (no subir imágenes reales al repositorio).
UPLOAD_DIR=data/fotos
# MercadoPago: usar credenciales de prueba en .env, NUNCA en Git.
MP_ACCESS_TOKEN=
MP_SANDBOX=true
