{
  "name": "viruta-match-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db-commands.js migrate",
    "db:seed": "node --env-file-if-exists=.env src/db-commands.js seed",
    "test": "vitest run",
    "lint": "eslint src tests",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "nodemailer": "7.0.13",
    "zod": "4.6.7",
    "node-cron": "4.6.0",
    "bcrypt": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express-rate-limit": "8.7.1"
  },
  "devDependencies": {
    "vitest": "3.2.7",
    "supertest": "7.3.1",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "globals": "16.5.0"
  }
}
